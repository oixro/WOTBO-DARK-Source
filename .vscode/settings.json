{
    "dotnet.defaultSolution": "Project.sln",
    "dotnet.preferCSharpExtension": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "search.exclude": {
        "**/bin": true,
        "**/obj": true,
        "**/artifacts": true,
        "**/.vs": true
    },
    "files.watcherExclude": {
        "**/bin/**": true,
        "**/obj/**": true,
        "**/artifacts/**": true,
        "**/.vs/**": true
    }
}
